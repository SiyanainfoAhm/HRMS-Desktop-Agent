{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HRMS Attendance Agent",
  "version": "0.1.0",
  "identifier": "com.siyanainfo.hrms-attendance-agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HRMS Attendance Agent",
        "width": 560,
        "height": 680,
        "minWidth": 560,
        "minHeight": 680,
        "maxWidth": 560,
        "maxHeight": 680,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "center": true,
        "decorations": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
